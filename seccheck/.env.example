# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
SECCHECK_DISCORD_USERNAME="gVisor SecCheck"

# Receiver
SECCHECK_SOCKET=/run/seccheck/events.sock
SECCHECK_ALERT_COOLDOWN=30

# Reconnect helper
RUNSC_ROOT=/var/run/docker/runtime-runc/moby
SECCHECK_CONFIG=/root/seccheck/session.json
