[Unit]
Description=gVisor SecCheck Receiver
Documentation=https://github.com/stypr/gvisor-seccheck
After=local-fs.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/seccheck/receiver.py
ExecStartPost=/root/seccheck/reconnect.sh
Restart=always
RestartSec=3
RuntimeDirectory=seccheck
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
UMask=0077

[Install]
WantedBy=multi-user.target
